{
  "name": "eventoscci",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --linked --include-seed",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "db:test:linked": "supabase db query --linked --output table -f supabase/tests/001_core_schema_test.sql && supabase db query --linked --output table -f supabase/tests/002_activities_schema_test.sql && supabase db query --linked --output table -f supabase/tests/003_registrations_schema_test.sql",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "types:db": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "types:db:linked": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
